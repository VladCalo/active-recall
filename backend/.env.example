# Active Recall Monitor - Backend Configuration
# Copy this file to .env and customize as needed
# NEVER commit .env to version control!

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# =============================================================================
# Database
# =============================================================================
# SQLite for local development
DATABASE_URL=sqlite:///./app.db

# PostgreSQL for production (uncomment and configure):
# DATABASE_URL=postgresql://user:password@localhost:5432/active_recall

# =============================================================================
# JWT Authentication (REQUIRED for production)
# =============================================================================
# Generate a secure secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# In development, a random key is generated if not set (sessions won't persist)
# In production, this MUST be set or the app will fail to start
JWT_SECRET_KEY=

# Token expiration (in minutes/days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS - Security
# =============================================================================
# Allowed frontend origins (comma-separated for JSON array format)
# In production, set to your actual frontend domain
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# =============================================================================
# Cookie Settings
# =============================================================================
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=100/minute

# =============================================================================
# Password Policy
# =============================================================================
MIN_PASSWORD_LENGTH=8

# =============================================================================
# Application
# =============================================================================
DEFAULT_TIMEZONE=Europe/Bucharest
