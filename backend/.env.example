# Active Recall Monitor - Backend Configuration
# Copy this file to .env and customize as needed

# Debug mode (set to true for development)
DEBUG=false

# Database URL (SQLite for local, Postgres for production)
DATABASE_URL=sqlite:///./app.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/active_recall

# CORS origins (comma-separated for multiple)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Default timezone for date calculations
DEFAULT_TIMEZONE=Europe/Bucharest
