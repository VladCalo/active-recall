# =============================================================================
# Active Recall Monitor - Backend Configuration
# =============================================================================
#
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control!
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# Debug mode - shows detailed errors (NEVER enable in production)
DEBUG=true

# =============================================================================
# Database
# =============================================================================
# SQLite for local development
DATABASE_URL=sqlite:///./app.db

# PostgreSQL for production (recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/active_recall

# =============================================================================
# Redis (for rate limiting)
# =============================================================================
# Comment out for in-memory rate limiting (development only)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT Authentication (REQUIRED for production)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development, a random key is generated if not set (sessions won't persist)
# In production, this MUST be set or the app will FAIL TO START
JWT_SECRET_KEY=

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CSRF Protection (REQUIRED for production)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET_KEY=

# =============================================================================
# CORS - Allowed Origins
# =============================================================================
# In production, set to your actual frontend domain(s)
# Format: JSON array of strings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# =============================================================================
# Cookie Settings
# =============================================================================
# COOKIE_SECURE=true requires HTTPS (set true in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# =============================================================================
# Rate Limiting
# =============================================================================
# Format: "count/period" (e.g., "5/minute", "10/hour", "100/day")
RATE_LIMIT_LOGIN=5/5minute
RATE_LIMIT_REGISTER=3/10minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_API_PER_USER=120/minute
RATE_LIMIT_API_PER_IP=60/minute

# =============================================================================
# Password Policy
# =============================================================================
MIN_PASSWORD_LENGTH=10
REQUIRE_PASSWORD_COMPLEXITY=true
CHECK_COMMON_PASSWORDS=true

# =============================================================================
# Brute Force Protection
# =============================================================================
LOGIN_DELAY_SECONDS=0.5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# Request Limits
# =============================================================================
MAX_REQUEST_BODY_SIZE=1048576
MAX_SUBJECT_NAME_LENGTH=255
MAX_INTERVALS_COUNT=50

# =============================================================================
# Application
# =============================================================================
DEFAULT_TIMEZONE=Europe/Bucharest

# =============================================================================
# Admin Account (CHANGE IN PRODUCTION!)
# =============================================================================
# Initial admin credentials - used to seed the first admin account
# In production, you MUST change these or set ADMIN_ALLOW_DEFAULT=true
# The app will REFUSE TO START in production with defaults unless allowed
ADMIN_EMAIL=adminvladcalo
ADMIN_PASSWORD=Adminvladcalo123!

# Set to true ONLY if you understand the security risk of default credentials
# This should NEVER be true in production unless temporarily for initial setup
ADMIN_ALLOW_DEFAULT=false
